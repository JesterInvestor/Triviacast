generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuizResult {
  id        String    @id @default(uuid())
  wallet    String
  points    Int?
  quizId    String?   @map("quiz_id")
  score     Int?
  details   Json?
  source    String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([wallet, createdAt], map: "idx_wallet_created_at")
  @@map("quiz_results")
}

model points_events {
  id         Int       @id @default(autoincrement())
  wallet     String
  points     Int
  source     String?
  quiz_id    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_points_created_at")
  @@index([wallet], map: "idx_points_wallet")
}
